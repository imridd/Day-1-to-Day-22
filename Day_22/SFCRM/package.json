{
  "name": "salesforce-crm-enterprise-teaching-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Account-free React + local Node CRM classroom simulator",
  "scripts": {
    "server": "node server/server.mjs",
    "dev": "vite --host 127.0.0.1",
    "start": "node server/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check:server": "node --check server/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/crm-demo.mjs",
    "migrate:mysql": "node server/migrate-json-to-mysql.mjs",
    "migrate:relational": "node server/migrate-json-to-relational.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
